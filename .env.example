NODE_ENV=development
PORT=5000

# MongoDB — set MONGODB_URI, or the parts below
# MONGODB_URI=mongodb+srv://user:pass@cluster/db
MONGODB_USER=your_username
MONGODB_PASSWORD=your_password
MONGODB_CLUSTER=your_cluster    #mongodb+srv://your_username:your_password@your_cluster/your_database
MONGODB_DB=your_database

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
JWT_REMEMBER_EXPIRES_IN=90d

# Shared with QuantumAI backend (≥32 chars) for /messages/quantum-ai-response receipts
QUANTUM_AI_SERVICE_SECRET=your_quantum_ai_service_secret

CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173


# ---------------------------------------------------------------------------
# Get these from your Cloudinary dashboard: https://console.cloudinary.com
# On Vercel: add to the BACKEND project (not frontend), enable Production,
# then Redeploy — saving vars alone does not update a running deployment.
#
# Option A — three variables (recommended):
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
#
# Option B — single URL (alternative on Vercel):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
#
# Verify production: GET /api/health → cloudinaryConfigured must be true.

# Web Push (browser / Windows toast notifications when you’re in another app)
VAPID_PUBLIC_KEY=your_vapid_public_key 
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# Microsoft Cognitive Services Translator (Transliterate API)
#
# Used to phonetically transliterate user display names into non-Latin scripts
# (Urdu, Arabic, Persian, Hindi, Chinese, Russian).
#
# If unset, the backend uses its built-in rule-based phonetic transliterator.
# When set, the real API is preferred; the built-in engine is used as fallback
# if the API call fails.
#
# Required:
#   MS_TRANSLATOR_KEY     — Azure Translator resource subscription key
#
# Optional (have sensible defaults):
#   MS_TRANSLATOR_REGION   — Azure region (default: "global")
#   MS_TRANSLATOR_ENDPOINT — API base URL (default: "https://api.cognitive.microsofttranslator.com")
#
# ---------------------------------------------------------------------------
# MS_TRANSLATOR_KEY=your_azure_translator_key
# MS_TRANSLATOR_REGION=eastus
# MS_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
#
# ── Manual verification after adding the key ──────────────────────────────
#
# 1. Uncomment and fill in MS_TRANSLATOR_KEY (and optionally REGION) above.
# 2. Restart the backend server.
# 3. On startup, the server log should print:
#      [transliterationService] MS_TRANSLATOR_KEY is configured — using Microsoft Translator Transliterate API (with fallback on failure).
#    If you instead see:
#      [transliterationService] MS_TRANSLATOR_KEY is not set — all transliterations will use the built-in fallback engine.
#    then the env var is not reaching the process (check .env path / dotenv loading).
#
# 4. Create a new account or update an existing user's display name.
#    • If the API key is VALID, the transliterated names will come from Microsoft's API.
#    • If the key is INVALID, you will see a log line like:
#        [transliterationService] API AUTH ERROR (HTTP 401) ...
#      followed by fallback engine results.
#
# 5. To re-transliterate all existing users with the real API, run:
#      node scripts/backfill-transliterations.js --yes --force
# ---------------------------------------------------------------------------

